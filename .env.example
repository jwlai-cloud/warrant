# ---- Token Factory (managed tier) ----
# Verified 2026-09-17 against docs.tokenfactory.nebius.com/quickstart.
# Nebius' own docs use NEBIUS_API_KEY for the key; WARRANT reads its own name.
WARRANT_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1
WARRANT_TF_API_KEY=

# ---- Self-hosted vLLM (sovereign tier), on a Nebius GPU Serverless Endpoint ----
# Created by scripts/deploy_vllm_endpoint.sh. The endpoint is deployed with
# --auth token, so the key is the AUTH_TOKEN you passed to that script - it is
# a real secret, not a placeholder. Never commit it.
WARRANT_VLLM_BASE_URL=https://<your-endpoint>.serverless.nebius.cloud/v1
WARRANT_VLLM_API_KEY=

# ---- Runtime ----
WARRANT_CONFIG=config/warrant.yaml
WARRANT_AUDIT_PATH=audit/warrant.jsonl
